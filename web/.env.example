PORT=3001

# Path to the compiled cpi binary (relative to web/ or absolute).
# Leave blank to let the server auto-detect:
#   Windows: ../build/Release/cpi.exe
#   Linux/macOS: ../build/cpi
CPI_BIN=

# Directories to scan for .ll2c model files.
# Use a single path or join multiple paths with the platform path separator:
#   Windows: ;
#   Linux/macOS: :
CPI_MODEL_DIRS=../artifacts

# Default model and tokenizer loaded at startup.
CPI_MODEL_PATH=
CPI_TOKENIZER_PATH=

# Chat template: tinyllama | tinyllama-chatml | llama2 | llama4
CPI_CHAT_TEMPLATE=

# Optional system prompt injected at the start of every conversation.
CPI_SYSTEM_PROMPT=You are a helpful assistant.

# Generation defaults (all overridable per-request from the UI).
CPI_MAX_NEW=256
CPI_MAX_CONTEXT=2048
CPI_TEMPERATURE=0.7
CPI_TOP_K=40
CPI_TOP_P=0.9
CPI_REPEAT_PENALTY=1.05

# Extra flags forwarded verbatim to cpi (e.g. --int8-streaming).
CPI_EXTRA_ARGS=
