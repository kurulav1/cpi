{
  "name": "cpi-chat-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,ui -c green,cyan \"node --watch server/index.mjs\" \"vite\"",
    "dev:lan": "concurrently -k -n api,ui -c green,cyan \"node --watch server/index.mjs\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "node server/index.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "katex": "^0.17.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@tailwindcss/vite": "^4.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "tailwindcss": "^4.2.1",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^1.2.0"
  }
}
